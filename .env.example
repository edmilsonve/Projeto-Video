# Roteiro: Claude é o principal; Gemini é a alternativa (e faz transcrição e TTS).
ANTHROPIC_API_KEY=your_anthropic_key
CLAUDE_MODEL_SCRIPT=claude-sonnet-5-5
CLAUDE_EFFORT_SCRIPT=medium

GEMINI_API_KEY=your_gemini_key
# Ou Vertex AI no lugar da chave: GOOGLE_CLOUD_PROJECT=meu-projeto e GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-flash-latest
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore

# Voz: auto (Kokoro local -> Gemini) | kokoro | gemini
VOICE_PROVIDER=auto
KOKORO_LANG=p
KOKORO_VOICE=pf_dora

STABILITY_API_KEY=your_stability_key
REPLICATE_API_TOKEN=your_replicate_token
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id
POLLINATIONS_URL=https://...
# YouTube: NÃO coloque credenciais aqui. Rode python -m scripts.youtube_auth (grava em ~/.config/darkstudio/,
# fora do repositório) e, no CI, use os secrets do ambiente youtube-production. Ver docs/AUTOMACAO_PUBLICACAO.md.
