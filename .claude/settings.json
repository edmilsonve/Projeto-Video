{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/client_secret*.json)",
      "Read(./**/service_account*.json)",
      "Read(./**/credentials*.json)",
      "Read(./**/token*.json)",
      "Read(~/.config/darkstudio/**)",
      "Read(~/.config/gcloud/**)",
      "Bash(python -m scripts.publish*)",
      "Bash(python3 -m scripts.publish*)",
      "Bash(python -m scripts.youtube_auth*)",
      "Bash(python3 -m scripts.youtube_auth*)",
      "Bash(gh secret*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"$CLAUDE_PROJECT_DIR/STOP\" ] || { echo 'DarkStudio pausado: existe o arquivo STOP na raiz. Remova-o para continuar.' >&2; exit 2; }",
            "statusMessage": "Checando kill switch"
          }
        ]
      }
    ]
  }
}
